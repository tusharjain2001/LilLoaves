# Copy to .env and fill in. .env is gitignored and must never be committed.

# WordPress/WooCommerce origin. Server-side only — never VITE_ prefixed, or the
# backend URL ends up in the browser bundle.
WP_STORE_URL=https://your-site.wpcomstaging.com

# Shared secret the bridge plugin's /quote endpoint requires as X-LL-Secret.
# Lives in the WordPress option `ll_bridge_secret` and in Vercel's env vars.
# Server-side only. Rotate with:
#   ssh lilloaves-wp "wp option update ll_bridge_secret <new>"
LL_BRIDGE_SECRET=

# Public checkout origin used as the checkout form's action attribute. This one
# is intentionally VITE_ prefixed and public — the browser must navigate to it.
VITE_WP_CHECKOUT_URL=https://your-site.wpcomstaging.com

# There is deliberately no variable for the order-notification service. Its
# URL is hardcoded in src/lib/notify.js — it is public either way, and a VITE_
# var is baked in at build time too, so it would need the same redeploy while
# adding the "unset var becomes the string undefined" failure mode. Change the
# constant, not this file. That service must list this storefront's origin in
# its own ALLOWED_ORIGINS.
